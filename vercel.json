{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm ci --prefix frontend --legacy-peer-deps",
  "buildCommand": "cd frontend && npx vite build",
  "outputDirectory": "frontend/dist",
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
